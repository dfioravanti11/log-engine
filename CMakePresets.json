{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "dev — RelWithDebInfo, tests + bench",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "release — O3, no tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LOGENGINE_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "asan — AddressSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LOGENGINE_SANITIZER": "address"
      }
    },
    {
      "name": "ubsan",
      "inherits": "base",
      "displayName": "ubsan — UndefinedBehaviorSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LOGENGINE_SANITIZER": "undefined"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "tsan — ThreadSanitizer (real runtime only; useless in sim)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LOGENGINE_SANITIZER": "thread"
      }
    },
    {
      "name": "msan",
      "inherits": "base",
      "displayName": "msan — MemorySanitizer (Linux + LLVM only)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LOGENGINE_SANITIZER": "memory"
      }
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "displayName": "fuzz — libFuzzer (Linux + LLVM only; week 2+)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "LOGENGINE_SANITIZER": "address",
        "LOGENGINE_BUILD_FUZZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "ubsan", "configurePreset": "ubsan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "msan", "configurePreset": "msan" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "dev", "inherits": "base", "configurePreset": "dev" },
    { "name": "asan", "inherits": "base", "configurePreset": "asan" },
    { "name": "ubsan", "inherits": "base", "configurePreset": "ubsan" },
    { "name": "tsan", "inherits": "base", "configurePreset": "tsan" },
    { "name": "msan", "inherits": "base", "configurePreset": "msan" }
  ]
}
