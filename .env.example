# ─────────────────────────────────────────────────────────────────────────────
# Distributed Replicated Log Engine — example environment
#
#   cp .env.example .env      # .env is gitignored; never commit it
#
# SCOPE NOTE: the broker itself is configured by CLI flags + a TOML config file,
# not by the environment (ER-1 keeps the OS out of src/; reading getenv() deep in
# server/ would violate it). Everything here is for the layers *outside* the
# binary: local dev convenience, the deploy/benchmark harness, and CI.
#
# Any var below may be overridden inline:  BENCH_DURATION_S=300 ./bench/run_all.sh
# ─────────────────────────────────────────────────────────────────────────────


# ── Local development ────────────────────────────────────────────────────────

# Where segments and raft.state live for a local single-node run.
LOG_DATA_DIR=./data

# trace | debug | info | warn | error
LOG_LEVEL=info

# CMake preset used by scripts/*.sh. See CMakePresets.json.
#   dev | release | asan | ubsan | tsan | msan | fuzz
CMAKE_PRESET=dev

# Parallel build jobs. Leave empty to use all cores.
BUILD_JOBS=


# ── Simulator ────────────────────────────────────────────────────────────────

# Seed for a one-off `./sim` run. Empty = pick a random seed and PRINT it
# (never silently discard a seed; a lost seed is a lost bug).
SIM_SEED=

# Seeds the fast CI job runs on every push (§18 — must finish under 5 min).
SIM_FIXED_SEED_COUNT=50

# Nightly soak: run random seeds until this budget is spent.
SIM_SOAK_MINUTES=60

# Simulated wall-clock per seed before the run is declared clean.
SIM_HORIZON_SECONDS=300

# Fail the run on the first invariant violation vs. collect all of them.
SIM_FAIL_FAST=true

# Written by CI when a seed fails, so sim-replay can pick it up.
SIM_FAILURE_ARTIFACT_DIR=./artifacts/sim


# ── Benchmark cluster (§19) ──────────────────────────────────────────────────

# PLACEHOLDER until the cluster exists — see "Cloud provider" below.
# Public IPs or DNS of the 3 broker hosts, comma-separated, in node-id order.
BENCH_NODE_HOSTS=TODO_NODE_0,TODO_NODE_1,TODO_NODE_2

# Separate host that runs the open-loop load generator. Do NOT co-locate it with
# a broker — the generator competing for cores corrupts the latency tail.
BENCH_CLIENT_HOST=TODO_CLIENT

# Until the VMs exist, run the whole harness against 3 local containers:
#   BENCH_LOCAL=true ./bench/run_all.sh
# Numbers from this mode are for smoke-testing the harness ONLY. They share a
# kernel, a page cache, and a disk queue, so they are not publishable — never
# let a local number reach the README.
BENCH_LOCAL=true

# SSH identity used by scripts/deploy.sh. Path only; the key never leaves your box.
BENCH_SSH_USER=root
BENCH_SSH_KEY=~/.ssh/id_ed25519

# Remote install prefix.
BENCH_REMOTE_DIR=/opt/logengine

# Load profile.
BENCH_RECORD_SIZE_BYTES=1024
BENCH_BATCH_SIZE_BYTES=65536
BENCH_ACKS=quorum              # 0 | 1 | quorum | quorum+fsync
BENCH_OFFERED_LOAD_MBPS=100    # open-loop: fixed arrival rate, NOT closed-loop
BENCH_DURATION_S=120
BENCH_WARMUP_S=30

# Failover experiment (§19, benchmark #3).
BENCH_FAILOVER_ITERATIONS=50
BENCH_FAILOVER_KILL_SIGNAL=KILL

# tc netem injection applied by scripts/netem.sh. Empty = no shaping.
BENCH_NETEM_DELAY_MS=
BENCH_NETEM_JITTER_MS=
BENCH_NETEM_LOSS_PCT=

# Where run_all.sh writes results. Committed summaries go to docs/bench/.
BENCH_RESULT_DIR=./artifacts/bench


# ── Cloud provider ──────────────────────────────── DEFERRED / NOT YET NEEDED ─
#
#   ┌─────────────────────────────────────────────────────────────────────┐
#   │  TODO(week-5): provision the benchmark cluster.                     │
#   │                                                                     │
#   │  Nothing in weeks 1–5 needs a cloud account. The simulator, the     │
#   │  storage engine, and all of Raft run on your laptop.                │
#   │                                                                     │
#   │  DO IT AT THE END OF WEEK 5, because week 6 writes the deploy       │
#   │  script and needs somewhere to deploy to, and because the GitHub    │
#   │  Student Pack (the thing that pays for this) takes a few days to    │
#   │  approve. Waiting until week 8 turns a $0 problem into a $25        │
#   │  problem and a two-day delay into a blocker.                        │
#   │                                                                     │
#   │  1. Apply: education.github.com/pack  (Cornell email)               │
#   │     → $200 DigitalOcean credit, covers the entire benchmark phase   │
#   │  2. Create 4 hosts: 3 brokers + 1 load generator                    │
#   │  3. DEDICATED vCPU, not shared/burstable — steal time on a shared   │
#   │     vCPU lands directly in your p99.9 and makes every latency       │
#   │     number in the README unfalsifiable                              │
#   │  4. Same region for all 4; record the region in the README          │
#   │  5. Fill in BENCH_NODE_HOSTS / BENCH_CLIENT_HOST above, flip        │
#   │     BENCH_LOCAL=false, and destroy the VMs between sessions         │
#   └─────────────────────────────────────────────────────────────────────┘
#
# Only needed if you provision from a script rather than the web console.
# SECRET — pick ONE and delete the other two.

# DigitalOcean — the default; this is where the student credit goes.
DIGITALOCEAN_TOKEN=
DO_REGION=nyc3
DO_DROPLET_SIZE=c-4            # CPU-Optimized, dedicated hyperthread

# Hetzner Cloud — cheapest if the credit runs out. ID verification takes ~1 day.
HCLOUD_TOKEN=
HCLOUD_LOCATION=ash            # ash | hil | nbg1 | fsn1 — keep all 4 hosts in one
HCLOUD_SERVER_TYPE=ccx13       # dedicated vCPU

# AWS — only if you specifically want real instance-store NVMe.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_INSTANCE_TYPE=i4i.large


# ── Observability (§FR-11) ───────────────────────────────────────────────────

# Port the broker exposes /metrics on.
METRICS_PORT=9100

# Local docker-compose Prometheus + Grafana (recommended — no account needed).
PROMETHEUS_SCRAPE_INTERVAL=1s
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=changeme        # SECRET (local only, but still)

# Grafana Cloud instead of self-hosted. Optional; leave blank to self-host.
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_API_KEY=                 # SECRET


# ── CI (set these as GitHub Actions repository secrets, not in .env) ─────────

# Container registry for the benchmark image. GHCR needs no extra account —
# GITHUB_TOKEN is injected by Actions automatically.
CONTAINER_REGISTRY=ghcr.io
CONTAINER_IMAGE=ghcr.io/<your-gh-user>/logengine

# Optional coverage upload. Delete if you skip Codecov.
CODECOV_TOKEN=                         # SECRET
